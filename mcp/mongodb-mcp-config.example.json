{
  "mcpServers": {
    "mongodb": {
      "command": "npx",
      "args": [
        "-y",
        "@mongodb-js/mongodb-mcp-server"
      ],
      "env": {
        "MONGODB_URI": "mongodb+srv://<username>:<password>@<cluster-url>/arrivalmate?retryWrites=true&w=majority",
        "MONGODB_DB": "arrivalmate"
      }
    }
  }
}
